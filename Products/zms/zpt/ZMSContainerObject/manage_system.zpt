<!DOCTYPE html>
<html lang="en" tal:define="standard modules/Products.zms/standard">
<head tal:replace="structure python:here.zmi_html_head(here,request)">zmi_html_head</head>
<body tal:attributes="class python:here.zmi_body_class(id='system')">

	<header tal:replace="structure python:here.zmi_body_header(here,request)">zmi_body_header</header>

	<div id="zmi-tab" 
		tal:define="
			zmscontext here;
			SecurityManager modules/AccessControl/getSecurityManager;
			skey python:request.get('skey', 'id');
			rkey python:request.get('rkey', 'asc')">

		<nav aria-label="breadcrumb" tal:replace="structure python:here.zmi_breadcrumbs(here,request)">zmi_breadcrumbs</nav>

		<form id="objectItems" name="objectItems" class="form-horizontal card" method="post" action="manage_main" tal:attributes="action python:here.absolute_url() + '/manage_main'">
			<input type="hidden" name="lang" tal:attributes="value request/lang" />
			<input type="hidden" name="preview" tal:attributes="value request/preview" />

			<!--! ##### Action-List ##### -->
			<select class="form-control" id="addItemSelect" name=":action" 
				tal:attributes="onchange python:'location.href=\'%s/\'+this.options[this.selectedIndex].value'%request['URL1']">
				<option value="manage_workspace" tal:content="python:'----- %s -----'%zmscontext.getZMILangStr('ACTION_INSERT')%zmscontext.display_type()">----- Insert -----</option>
				<option
					tal:repeat="meta_type python:[x for x in zmscontext.sort_list(zmscontext.filtered_meta_types(),'name') if x['name'].find('ZMS')!=0]" 
					tal:attributes="value python:meta_type['action']" tal:content="python:meta_type['name']">
					the name
				</option>
			</select>
			<legend tal:content="python:here.getZMILangStr('TAB_SYSTEM')">System</legend>

			<!--! ##### Object-List ##### -->
			<tal:block tal:define="items python:zmscontext.manage_get_sortedObjects(sortkey = skey, revkey = rkey)">
				<tal:block tal:condition="python:len(items)>0">
					<table class="table table-sm table-striped zopeobjects objectItems">
						<thead>
							<tr>
								<th class="zmi-object-check">
									<div class="btn-group">
										<button class="btn btn-secondary border-0" onclick="zmiToggleSelectionButtonClick(this);return false"><i class="fas fa-check-square"></i></button>
									</div>
								</th>
								<tal:block define="columns python:{
									'meta_type':'type',
									'id':'name',
									'get_size':'size',
									'bobobase_modification_time':'last_modified'
									}">
									<tal:block tal:repeat="column python:columns.keys()">
										<th tal:define="label python:zmscontext.getZMILangStr('ATTR_%s'%columns[column].upper())"
											tal:attributes="class python:'zmi-object-%s%s'%(columns[column], column=='bobobase_modification_time' and ' d-none d-sm-table-cell' or '')">
											<i tal:condition="python:skey==column" 
												tal:attributes="class python:'text-danger fas fa-caret-%s'%(['down','up'][int(rkey=='asc')])"></i>
											<a class="text-dark" 
												tal:attributes="
													href python:zmscontext.url_append_params(zmscontext.absolute_url() + '/manage_main',{'skey':column,'rkey':['asc','desc'][int(rkey=='asc')]}); 
													title python:'Sort objects by %s'%label"
												tal:content="label">the label
											</a>
											<div tal:condition="python:column=='id'" 
												class="btn-group filtering"
												style="position: absolute; margin: -.45rem 1rem 0 1rem;"
												title="Filter object list by entering a name.">
												<i class="fas fa-filter tablefilter p-2" onclick="$('#tablefilter').focus().addClass('visited')"></i>
												<input id="tablefilter" name="tablefilter" class="form-control" type="text" />
											</div>
										</th>
									</tal:block>
								</tal:block>
							</tr>
						</thead>
						<tbody>
							<tr tal:repeat="item items">
								<td class="zmi-object-check">
									<input type="checkbox" name="ids:list" tal:attributes="value python:item['id']"/>
								</td>
								<td class="zmi-object-type">
									<tal:block tal:define="icon python:item['obj'].zmi_icon"
										tal:on-error="structure string:<i title='Error: No Icon Found' class='fas fa-exclamation-triangle text-danger'></i>">
										<i tal:attributes="class icon; title python:item['obj'].meta_type" />
									</tal:block>
								</td>
								<td class="zmi-object-id">
									<a target="_blank" tal:on-error="python:'%s (Broken Object!)'%item['id']" 
										tal:attributes="href python:'%s/manage_workspace'%item['obj'].absolute_url()">
										<tal:block tal:content="python:item['id']">the id</tal:block>
										<tal:block tal:condition="python:item['obj'].title_or_id()">
											(<tal:block tal:content="python:item['obj'].title_or_id()">the title</tal:block>)
										</tal:block>
									</a>
								</td>
								<td class="zmi-object-size">
									<tal:block 
										tal:condition="python:item['obj'].meta_type!='External Method'" 
										tal:content="python:zmscontext.getDataSizeStr(item['obj'].get_size())" 
										tal:on-error="string:get_size is not defined!">the size
									</tal:block>
								</td>
								<td class="zmi-object-date zmi-object-last_modified d-none d-sm-table-cell">
									<tal:block 
										tal:content="python:zmscontext.last_modified(item['obj'])" 
										tal:on-error="string:last_modified is not defined!">the timestamp
									</tal:block>
								</td>
							</tr>
						</tbody>
					</table>
					<div class="form-group form-inline zmi-controls" tal:condition="not:python:request.get('dontAllowCopyAndPaste')">
						<div class="pb-4 pl-2">
							<input class="btn btn-secondary m-1" type="submit" name="manage_renameForm:method" tal:attributes="value python:zmscontext.getZMILangStr('BTN_RENAME')" tal:condition="items"/>
							<input class="btn btn-secondary m-1" type="submit" name="manage_cutObjects:method" tal:attributes="value python:zmscontext.getZMILangStr('BTN_CUT')" tal:condition="items"/>
							<input class="btn btn-secondary m-1" type="submit" name="manage_copyObjects:method" tal:attributes="value python:zmscontext.getZMILangStr('BTN_COPY')" tal:condition="items"/>
							<input class="btn btn-secondary m-1" type="submit" name="manage_pasteObjects:method" tal:attributes="value python:zmscontext.getZMILangStr('BTN_PASTE')" tal:condition="python:here.cb_dataValid()"/>
							<input class="btn btn-secondary m-1" type="submit" name="manage_delObjects:method" tal:attributes="value python:zmscontext.getZMILangStr('BTN_DELETE')" tal:condition="python:SecurityManager.checkPermission('Delete objects',zmscontext)"/>
							<input class="btn btn-secondary m-1" type="submit" name="manage_importExportForm:method" value="Import/Export" tal:condition="python:SecurityManager.checkPermission('Import/Export objects',zmscontext)"/>
						</div>
					</div>
				</tal:block>
			</tal:block>

		</form>

	</div><!-- #zmi-tab -->
	<footer tal:replace="structure python:here.zmi_body_footer(here,request)">zmi_body_footer</footer>
	<script>
	//<!--
		$(function () {

			// +++++++++++++++++++++++++++
			// Tablefilter: Object-List
			// +++++++++++++++++++++++++++
			function isModifierKeyPressed(event) {
				return event.altKey ||
				event.ctrlKey ||
				event.metaKey;
			}
			$(document).keypress(function (event) {
				if (isModifierKeyPressed(event)) {
					return; // ignore
				}
				// Set Focus to Tablefilter only when no modal dialog is shown
				if (!$('.modal.show').length) {
					$('#tablefilter').focus().addClass('visited');
				};
			})
			$('#tablefilter').keyup(function (event) {
				let tablefilter = $(this).val();
				if (isModifierKeyPressed(event)) {
					return; // ignore
				}
				if (event.which == 13) {
					event.preventDefault();
				};
				$('table.objectItems').find("tbody tr").hide();
				$('table.objectItems').find("tbody tr td.zmi-object-id a:contains(" + tablefilter + ")").closest('tbody tr').show();
			});
		});
	//-->
	</script>
</body>
</html>
