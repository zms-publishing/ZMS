<!DOCTYPE html>
<html lang="en" tal:define="standard modules/Products.zms/standard">
<head tal:replace="structure python:here.zmi_html_head(here,request)">zmi_html_head</head>
<body tal:attributes="class python:here.zmi_body_class(id='importexportdebugfilter')">
<header tal:replace="structure python:here.zmi_body_header(here,request)">zmi_body_header</header>
<div id="zmi-tab">
<!--! Save export node after initialization for breadcrumb on the further process-steps -->
<tal:block tal:condition="python:here.getId()!='zms_log'">
	<tal:block tal:define="global content_uid python:here.get_uid();"
		tal:content="structure python:here.zmi_breadcrumbs(here,request)">
		zmi_breadcrumbs
	</tal:block>
</tal:block>
<tal:block tal:condition="python:here.getId()=='zms_log'">
	<tal:block tal:define="
		global content_uid python:request.get('content_uid',here.get_uid());
		content_obj python:here.getLinkObj('{$%s}'%content_uid);"
		tal:content="structure python:content_obj.zmi_breadcrumbs(here,request)">
		zmi_breadcrumbs
	</tal:block>
</tal:block>

<style>
/*<!-- */
	.filterName {
		padding-left:0.4em;
	}
	.filterSelect {
		text-align: center;
	}
	.filterSelect input {
		margin-top:1.75em;
	}
	.filterProcesses {
		margin:1em;
	}
	.filterDelimiter {
		background-color:#D0D0FF;
		border:1px navy solid;
		border-radius:5px;
		margin:.1em;
		max-width:20em;
		min-width:10em;
		overflow:hidden;
		text-align:center;
		padding:2px 4px 2px 4px;
	}
	.filterProcess {
		background-color:#D0FFD0;
		border:1px navy solid;
		border-radius:5px;
		font-weight:normal;
		margin:.1em;
		max-width:20em;
		text-align:center;
		padding:2px 4px 2px 4px;
	}
	.filterDelimiter.active,
	.filterProcess.active {
		background-color:#FFD0D0;
		border:2px red solid;
	}
	.filterProcessFile {
		display:block;
		position:relative;
		text-align:left;
		background-color:#ffffdd;
		border:1px #CCC solid;
		border-radius:4px;
		font-weight:normal;
		padding: 4px 1em 4px 2em;
		width: 14em;
		overflow:hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: #212529;
		text-decoration:none;
	}
	.active .filterProcessFile,
	.filterProcessFile:hover {
		color:white;
		text-decoration:none;
		background-color: #337ab7;
		border: 1px #2e6da4 solid;
		cursor:pointer;
	}
	.filterProcessFile i:before {
		position: absolute !important;
		display: block;
		color: #ffffff;
		background: #869596;
		height: 1.9rem;
		width: 1.75rem;
		text-align: center;
		border-top-left-radius: 4px;
		border-bottom-left-radius: 4px;
		margin: -1.25rem 0 0 -1.75rem;
		line-height: 2.1;
	}
	.active .filterProcessFile i:before,
	.filterProcessFile:hover i:before {
		background-color: #354f67;
	}
	.layoutTable th, .layoutTable td {
		padding:0;
		vertical-align:top;
		border:0 !important;
		text-align:center;
	}
	.layoutTable td {
		padding:0 !important;
	}
/*-->*/
</style>
<script type="text/javascript">
	// on ready scroll to element-class .filterProcess.active
	$(document).ready(function() {
		var $active = $('.filterProcess.active');
		if ($active.length) {
			document.documentElement.scrollTop = 154;
			$('html, body').animate({
				scrollTop: $active.offset().top - 178
			}, 1000);
		}
	});
</script>

<tal:block define="
		step            python:request.get('step',0);
		filterId        request/filterId;
		filter_manager  python:here.getFilterManager();
		filter          python:filter_manager.getFilter(filterId);
		filterProcesses python:filter_manager.getFilterProcesses(filter['id'])">
	<tal:block tal:condition="python:step==0">
		<tal:block define="
			tpl         python:here.initExportFilter(filter['id'],request);
			dummy0      python:request.set('tempfolder',tpl[0]);
			dummy0      python:request.set('outfilename',tpl[1])">
		</tal:block>
	</tal:block>
	<tal:block tal:condition="python:step>0 and step <= len(filterProcesses)">
		<tal:block define="
			dummy0 python:request.set('outfilename',here.execProcessFilter(filterProcesses[step-1],request['tempfolder'],request['outfilename'],request));
			dummy0 python:request.RESPONSE.setHeader('Content-Type','text/html\073charset=%s'%request['ZMS_CHARSET'])">
		</tal:block>
	</tal:block>

<form class="form-horizontal card" action="manage_importexportDebugFilter">
	<input type="hidden" name="lang" tal:attributes="value request/lang"/>
	<input type="hidden" name="filterId" tal:attributes="value request/filterId"/>
	<input type="hidden" name="debug:int" tal:attributes="value request/debug"/>
	<input type="hidden" name="step:int" tal:attributes="value python:step+1"/>
	<input type="hidden" name="tempfolder" tal:attributes="value request/tempfolder"/>
	<input type="hidden" name="outfilename" tal:attributes="value request/outfilename"/>
	<input type="hidden" name="content_uid" tal:attributes="value content_uid"/>

	<div class="sticky-controls">
		<legend>
			<span title="Filter Step Count"
				tal:content="python:here.getZMILangStr('ATTR_EXPORT')+' [%i/%i] '%(step,len(filterProcesses))">
				Export
			</span>
			<span title="Filter Name" class="mx-2" >
				<i class="fas fa-filter"></i>
				<tal:block tal:content="filter/name">the filter-name</tal:block>
			</span>
			<span title="Output Filename" class="badge badge-light text-monospace mx-2" style="font-size:100%;">
				<i class="fas fa-folder-open text-info"></i>
				<tal:block tal:content="request/outfilename">Outfilename</tal:block>
			</span>
		</legend>
		<div class="d-flex flex-row justify-content-between align-items-start p-4">
			<button title="Execute Next Filter Step" class="btn btn-primary"
				onclick="$('i',this).attr('class','fas fa-spinner fa-spin mr-1');">
				<i class="fas fa-forward mr-1"></i> 
				<tal:block tal:content="python:here.getZMILangStr('BTN_NEXT')">Next</tal:block>
			</button>
		</div>
	</div>
	<div class="card-body pt-0">
		<div class="row">
			<div class="col-6  pt-2">
				<table class="layoutTable">
					<tr>
						<td>
							<div tal:attributes="class python:' '.join(['filterDelimiter']+[[],['active']][int(step==0)])">
								<i class="fas fa-upload" tal:condition="python:filter.get('format','Missing filter format')=='import'"></i>
								<i class="fas fa-download" tal:condition="python:filter.get('format','Missing filter format')!='import'"></i>
								<span tal:content="python:filter.get('format','Unkown filter format')"></span>
							</div>
							<i class="fas fa-long-arrow-alt-down center"></i>
						</td>
					</tr>
					<tr tal:repeat="i python:range(len(filterProcesses))"
						tal:attributes="class python:int(step==i+1) and 'active' or None">
						<tal:block tal:define="
							filterProcess python:filterProcesses[i];
							process python:filter_manager.getProcess(filterProcess['id'])">
							<td>
								<div tal:attributes="class python:' '.join(['filterProcess']+[[],['active']][int(step==i+1)])" 
									tal:content="process/name">the process-name
								</div>
								<i class="fas fa-long-arrow-alt-down center"></i>
							</td>
							<tal:block tal:condition="python:filterProcess.get('file_filename')">
								<td>
									<hr style="margin:1em 0;width:120px;border-top:1px solid #888;padding:0;" />
								</td>
								<td>
									<a class="filterProcessFile"
										tal:define="
											process_filename python:filterProcess['file_filename'];
											process_content_type python:filterProcess['file_content_type'];
											process_href python:'%s/manage_main'%(filterProcess['file_href']);"
										tal:attributes="href process_href; title python:'%s (%s)'%(process_filename, process_content_type)">
										<i tal:attributes="class python:standard.getFileTypeIconCSS(process_filename); title python:process_content_type"></i>
										<span class="ml-1" tal:content="process_filename">FILENAME</span>
									</a>
								</td>
							</tal:block>
						</tal:block>
					</tr>
					<tr>
						<td>
							<div class="filterDelimiter">
								<i class="fas fa-upload" tal:condition="python:filter.get('format','Missing filter format')=='import'"></i>
								<i class="fas fa-download" tal:condition="python:filter.get('format','Missing filter format')!='import'"></i>
								<span tal:content="python:filter.get('content_type','Unkown content type')"></span>
							</div>
						</td>
					</tr>
				</table><!-- .layoutTable -->
			</div>

			<div class="col-6 pt-2">
				<iframe class="border rounded" tal:attributes="src python:'%s/manage_remote?path=%s'%(here.zms_log.absolute_url(),request['tempfolder'])" 
					width="100%" height="600" style="height:100%;min-height:100vh;"></iframe>
			</div>
		</div>
	</div>
</form>

</tal:block>

</div><!-- #zmi-tab -->
<footer tal:replace="structure python:here.zmi_body_footer(here,request)">zmi_body_footer</footer>
</body>
</html>
